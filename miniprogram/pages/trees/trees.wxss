  }
}

@keyframes knowledge-branch-flow {
  0% {
    filter: brightness(0.94);
    box-shadow: 0 0 0 rgba(0, 0, 0, 0);
  }
  50% {
    filter: brightness(1.16);
    box-shadow: 0 0 18rpx rgba(104, 206, 255, 0.18);
  }
  100% {
    filter: brightness(0.94);
    box-shadow: 0 0 0 rgba(0, 0, 0, 0);
  }
}

@keyframes knowledge-orb-float {
  0%, 100% {
    transform: translateY(0) scale(1);
  }
  50% {
    transform: translateY(-6rpx) scale(1.04);
  }
}

@keyframes knowledge-orb-pulse {
  0% {
    transform: scale(0.82);
    opacity: 0.54;
  }
  100% {
    transform: scale(1.34);
    opacity: 0;
  }
}

@keyframes knowledge-sparkle-flicker {
  0%, 100% {
    transform: scale(0.84);
    opacity: 0.32;
  }
  35% {
    transform: scale(1.08);
    opacity: 0.72;
  }
  70% {
    transform: scale(0.92);
    opacity: 0.46;
  }
}

