@import "../../app.wxss";

.page-card {
  animation: page-card-rise 480ms cubic-bezier(0.2, 0.85, 0.25, 1) both;
}

.focus-module {
  position: relative;
  transform-origin: center center;
  transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease, filter 220ms ease;
}

.focus-module::before {
  content: '';
  position: absolute;
  inset: -2rpx;
  border-radius: inherit;
  border: 1rpx solid rgba(120, 170, 255, 0);
  box-shadow: 0 0 0 0 rgba(91, 162, 255, 0);
  opacity: 0;
  pointer-events: none;
  transition: opacity 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
}

.focus-module-active {
  z-index: 2;
  transform: translateY(-10rpx) scale(1.012);
  border-color: rgba(120, 181, 255, 0.38);
  box-shadow: 0 30rpx 64rpx rgba(8, 24, 52, 0.5), 0 0 0 1rpx rgba(120, 181, 255, 0.16);
  filter: saturate(1.14) brightness(1.1);
}

.focus-module-active::before {
  opacity: 1;
  border-color: rgba(120, 181, 255, 0.34);
  box-shadow: 0 0 0 10rpx rgba(84, 160, 255, 0.08), 0 0 36rpx rgba(69, 154, 255, 0.16);
}

.focus-module-active .section-tag {
  box-shadow: 0 0 0 1rpx rgba(141, 205, 255, 0.10), 0 10rpx 20rpx rgba(22, 88, 196, 0.16);
}

.tree-card.focus-module-active .tree-cover-panel,
.page-card.focus-module-active .overview-progress-card,
.page-card.focus-module-active .profile-stat-card,
.page-card.focus-module-active .activity-stat-item {
  border-color: rgba(132, 193, 255, 0.3);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.08), 0 18rpx 34rpx rgba(18, 61, 128, 0.22);
  filter: brightness(1.06);
}

.node-row.focus-module-active {
  border-color: rgba(126, 192, 255, 0.32);
  background: linear-gradient(180deg, rgba(13, 31, 59, 0.98), rgba(8, 21, 42, 0.98));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.06), 0 24rpx 42rpx rgba(10, 32, 68, 0.42), 0 0 0 1rpx rgba(132, 193, 255, 0.12);
  filter: saturate(1.18) brightness(1.15);
}

.node-row.focus-module-active::after {
  background: radial-gradient(circle, rgba(109, 181, 255, 0.16) 0%, rgba(109, 181, 255, 0) 72%);
}

.node-row.focus-module-active .node-title-name {
  color: #ffffff;
}

.node-row.focus-module-active .node-summary-line,
.node-row.focus-module-active .node-progress-copy,
.node-row.focus-module-active .node-title-path,
.node-row.focus-module-active .subtle {
  color: rgba(225, 237, 255, 0.9);
}

.node-row.focus-module-active .node-progress-box,
.node-row.focus-module-active .node-work,
.node-row.focus-module-active .problem-box,
.node-row.focus-module-active .submission-item,
.node-row.focus-module-active .file-item {
  border-color: rgba(132, 193, 255, 0.28);
  background: linear-gradient(180deg, rgba(14, 29, 57, 0.94), rgba(10, 23, 43, 0.96));
}

.page-card-hero {
  animation-delay: 40ms;
}

.page-card-profile {
  animation-delay: 70ms;
}

.student-hero-panel {
  margin-top: 14rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
}

.student-hero-main {
  flex: 1;
  min-width: 0;
}

.student-hero-name {
  font-size: 48rpx;
  line-height: 1.28;
  font-weight: 700;
  color: #f7fbff;
}

.student-hero-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(214, 229, 255, 0.76);
}

.student-hero-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.student-hero-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
}

.student-hero-chip-blue {
  color: #dce8ff;
  background: rgba(78, 131, 255, 0.16);
}

.student-hero-chip-amber {
  color: #cbfff1;
  background: rgba(61, 207, 181, 0.18);
}

.profile-stats-grid {
  margin-top: 14rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.profile-stat-card {
  min-height: 96rpx;
  padding: 18rpx 18rpx;
  border-radius: 22rpx;
  border: 1rpx solid rgba(113, 153, 216, 0.18);
  background: linear-gradient(180deg, rgba(12, 27, 52, 0.88), rgba(8, 19, 38, 0.92));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.04), 0 16rpx 28rpx rgba(1, 8, 20, 0.30);
}


.profile-stat-card-wide {
  grid-column: 1 / -1;
}

.profile-stat-label {
  font-size: 24rpx;
  color: rgba(176, 196, 224, 0.74);
}

.profile-stat-value {
  margin-top: 12rpx;
  font-size: 30rpx;
  line-height: 1.32;
  font-weight: 700;
  color: #f4f8ff;
}

.profile-stat-value-long {
  font-size: 28rpx;
}

.page-card-activity {
  animation-delay: 100ms;
}


.page-card-knowledge {
  animation-delay: 86ms;
}


.page-card-reward-scene {
  animation-delay: 112ms;
}

.constellation-card {
  overflow: hidden;
}

.constellation-toggle,
.profile-toggle {
  margin-top: 18rpx;
  align-self: flex-start;
}

.panel-collapsed-note {
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  border: 1rpx dashed rgba(108, 150, 214, 0.24);
  background: linear-gradient(180deg, rgba(10, 24, 45, 0.76), rgba(7, 18, 35, 0.82));
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(191, 213, 245, 0.74);
}

.profile-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}


.constellation-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.constellation-head-main {
  flex: 1;
  min-width: 0;
}

.constellation-head-main .subtle {
  margin-top: 10rpx;
}

.constellation-badge {
  flex-shrink: 0;
  min-width: 116rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(130, 186, 255, 0.24);
  background: linear-gradient(180deg, rgba(17, 45, 86, 0.94), rgba(8, 20, 42, 0.92));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.08), 0 18rpx 30rpx rgba(7, 18, 36, 0.28);
  color: #f3f8ff;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
}

.constellation-badge-reward {
  border-color: rgba(108, 233, 214, 0.24);
  background: linear-gradient(180deg, rgba(8, 50, 60, 0.94), rgba(6, 24, 30, 0.92));
}

.constellation-stage {
  position: relative;
  overflow: hidden;
  margin-top: 18rpx;
  height: 600rpx;
  border-radius: 30rpx;
  border: 1rpx solid rgba(109, 156, 224, 0.16);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.06), 0 24rpx 44rpx rgba(1, 8, 20, 0.28);
}

.constellation-stage-knowledge {
  background: linear-gradient(180deg, rgba(8, 19, 40, 0.98), rgba(6, 14, 29, 0.96) 54%, rgba(6, 18, 28, 0.98));
}

.constellation-stage-reward {
  border-color: rgba(85, 209, 196, 0.16);
  background: linear-gradient(180deg, rgba(6, 21, 30, 0.98), rgba(4, 15, 20, 0.96) 54%, rgba(5, 18, 21, 0.98));
}

.constellation-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

.constellation-overlay {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  bottom: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(120, 166, 255, 0.14);
  background: linear-gradient(180deg, rgba(7, 17, 31, 0.82), rgba(5, 12, 24, 0.9));
}

.constellation-stage-reward .constellation-overlay {
  border-color: rgba(103, 221, 214, 0.14);
  background: linear-gradient(180deg, rgba(6, 20, 27, 0.82), rgba(4, 13, 18, 0.9));
}

.constellation-overlay-copy {
  color: #eef6ff;
  font-size: 24rpx;
  line-height: 1.55;
}

.constellation-overlay-hint {
  margin-top: 8rpx;
  color: rgba(191, 214, 243, 0.72);
  font-size: 20rpx;
}

.constellation-empty {
  position: absolute;
  left: 50%;
  top: 46%;
  width: 360rpx;
  transform: translate(-50%, -50%);
  text-align: center;
  color: rgba(196, 214, 238, 0.72);
  line-height: 1.68;
  font-size: 24rpx;
}

.constellation-stats {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.constellation-stat-card {
  padding: 18rpx;
  border-radius: 22rpx;
  border: 1rpx solid rgba(117, 168, 240, 0.16);
  background: linear-gradient(180deg, rgba(11, 25, 49, 0.92), rgba(8, 18, 35, 0.96));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
}

.constellation-stat-card-reward {
  border-color: rgba(92, 198, 196, 0.16);
  background: linear-gradient(180deg, rgba(7, 25, 34, 0.92), rgba(6, 17, 22, 0.96));
}

.constellation-stat-label {
  font-size: 22rpx;
  color: rgba(174, 197, 228, 0.74);
}

.constellation-stat-value {
  margin-top: 10rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #f5fbff;
}

.knowledge-scene-card {
  overflow: hidden;
}

.knowledge-scene-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.knowledge-scene-head .subtle {
  margin-top: 10rpx;
}

.knowledge-scene-badge {
  flex-shrink: 0;
  min-width: 116rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(130, 186, 255, 0.24);
  background: linear-gradient(180deg, rgba(17, 45, 86, 0.94), rgba(8, 20, 42, 0.92));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.08), 0 18rpx 30rpx rgba(7, 18, 36, 0.28);
  color: #f3f8ff;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
}

.knowledge-scene-stage {
  position: relative;
  overflow: hidden;
  margin-top: 18rpx;
  min-height: 548rpx;
  border-radius: 30rpx;
  border: 1rpx solid rgba(109, 156, 224, 0.16);
  background:
    radial-gradient(circle at top, rgba(59, 122, 255, 0.16), rgba(59, 122, 255, 0) 42%),
    linear-gradient(180deg, rgba(8, 19, 40, 0.98), rgba(6, 14, 29, 0.96) 54%, rgba(6, 18, 28, 0.98));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.06), inset 0 -24rpx 60rpx rgba(8, 40, 54, 0.22), 0 24rpx 44rpx rgba(1, 8, 20, 0.28);
}

.knowledge-scene-grid,
.knowledge-scene-aura,
.knowledge-tree-crown,
.knowledge-tree-ground,
.knowledge-tree-roots,
.knowledge-tree-trunk,
.knowledge-branch-line,
.knowledge-branch-glow,
.knowledge-branch-label,
.knowledge-orb,
.knowledge-sparkle,
.knowledge-scene-empty {
  position: absolute;
}

.knowledge-scene-grid {
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background-image:
    linear-gradient(rgba(134, 178, 255, 0.06) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(134, 178, 255, 0.05) 1rpx, transparent 1rpx);
  background-size: 48rpx 48rpx, 48rpx 48rpx;
  opacity: 0.38;
}

.knowledge-scene-aura {
  width: 300rpx;
  height: 300rpx;
  border-radius: 999rpx;
  filter: blur(8rpx);
  opacity: 0.42;
}

.knowledge-scene-aura-left {
  left: -72rpx;
  top: 34rpx;
  background: radial-gradient(circle, rgba(49, 112, 255, 0.30), rgba(49, 112, 255, 0) 70%);
  animation: knowledge-aura-left 7.2s ease-in-out infinite;
}

.knowledge-scene-aura-right {
  right: -88rpx;
  top: 110rpx;
  background: radial-gradient(circle, rgba(70, 255, 214, 0.20), rgba(70, 255, 214, 0) 72%);
  animation: knowledge-aura-right 8.2s ease-in-out infinite;
}

.knowledge-tree-ground {
  left: 64rpx;
  right: 64rpx;
  bottom: 38rpx;
  height: 120rpx;
  border-radius: 999rpx;
  background: radial-gradient(circle at center, rgba(33, 146, 123, 0.28), rgba(13, 30, 40, 0) 72%);
  filter: blur(6rpx);
}

.knowledge-tree-roots {
  left: 50%;
  bottom: 64rpx;
  width: 276rpx;
  height: 88rpx;
  margin-left: -138rpx;
  background:
    radial-gradient(circle at 22% 58%, rgba(105, 190, 255, 0.16), rgba(105, 190, 255, 0) 36%),
    radial-gradient(circle at 78% 62%, rgba(97, 255, 214, 0.12), rgba(97, 255, 214, 0) 34%);
  opacity: 0.9;
}

.knowledge-tree-roots::before,
.knowledge-tree-roots::after {
  content: '';
  position: absolute;
  bottom: 12rpx;
  width: 128rpx;
  height: 44rpx;
  border-bottom: 3rpx solid rgba(111, 176, 255, 0.26);
  border-radius: 0 0 120rpx 120rpx;
}

.knowledge-tree-roots::before {
  left: 0;
  transform: rotate(-10deg);
}

.knowledge-tree-roots::after {
  right: 0;
  transform: rotate(10deg);
}

.knowledge-tree-trunk {
  left: 50%;
  bottom: 108rpx;
  width: 82rpx;
  height: 248rpx;
  margin-left: -41rpx;
  border-radius: 34rpx 34rpx 28rpx 28rpx;
  transform-origin: center bottom;
  background: linear-gradient(180deg, rgba(99, 174, 255, 0.90), rgba(32, 94, 188, 0.88) 42%, rgba(10, 37, 88, 0.98));
  box-shadow: inset 10rpx 0 20rpx rgba(255, 255, 255, 0.14), inset -14rpx 0 22rpx rgba(4, 16, 37, 0.44), 0 18rpx 40rpx rgba(38, 104, 214, 0.18);
}

.knowledge-tree-trunk::before {
  content: '';
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  top: 18rpx;
  height: 158rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.18), rgba(255, 255, 255, 0));
  opacity: 0.82;
}

.knowledge-tree-trunk::after {
  content: '';
  position: absolute;
  left: 16rpx;
  right: 16rpx;
  top: 28rpx;
  bottom: 22rpx;
  border-radius: 999rpx;
  border-left: 2rpx solid rgba(255, 255, 255, 0.08);
  border-right: 2rpx solid rgba(6, 20, 46, 0.24);
}

.knowledge-tree-trunk-dormant {
  opacity: 0.42;
  filter: saturate(0.72);
}

.knowledge-tree-trunk-growing {
  animation: knowledge-trunk-awaken 3.8s ease-in-out infinite;
}

.knowledge-tree-trunk-awake {
  animation: knowledge-trunk-awaken 2.9s ease-in-out infinite;
  box-shadow: inset 10rpx 0 20rpx rgba(255, 255, 255, 0.18), inset -14rpx 0 22rpx rgba(4, 16, 37, 0.42), 0 18rpx 40rpx rgba(38, 104, 214, 0.24), 0 0 48rpx rgba(70, 181, 255, 0.18);
}

.knowledge-tree-crown {
  left: 50%;
  top: 76rpx;
  width: 360rpx;
  height: 220rpx;
  margin-left: -180rpx;
  border-radius: 50% 50% 46% 46%;
  background:
    radial-gradient(circle at 50% 34%, rgba(164, 255, 235, 0.72), rgba(164, 255, 235, 0.18) 20%, rgba(65, 164, 255, 0.30) 42%, rgba(65, 164, 255, 0) 72%),
    radial-gradient(circle at 30% 68%, rgba(73, 196, 255, 0.26), rgba(73, 196, 255, 0) 64%),
    radial-gradient(circle at 74% 66%, rgba(86, 255, 212, 0.26), rgba(86, 255, 212, 0) 64%);
  filter: blur(2rpx);
  opacity: 0.92;
}

.knowledge-tree-crown::before,
.knowledge-tree-crown::after {
  content: '';
  position: absolute;
  border-radius: 999rpx;
}

.knowledge-tree-crown::before {
  left: 42rpx;
  right: 42rpx;
  top: 26rpx;
  bottom: 42rpx;
  background: radial-gradient(circle at center, rgba(182, 255, 236, 0.36), rgba(182, 255, 236, 0) 68%);
}

.knowledge-tree-crown::after {
  left: 18rpx;
  right: 18rpx;
  top: 18rpx;
  bottom: 20rpx;
  border: 1rpx solid rgba(139, 214, 255, 0.16);
}

.knowledge-tree-crown-dormant {
  opacity: 0.26;
  transform: scale(0.92);
}

.knowledge-tree-crown-growing {
  animation: knowledge-crown-breathe 4.6s ease-in-out infinite;
}

.knowledge-tree-crown-awake {
  animation: knowledge-crown-breathe 3.4s ease-in-out infinite;
  box-shadow: 0 0 80rpx rgba(101, 225, 255, 0.16);
}

.knowledge-branch-line,
.knowledge-branch-glow {
  transform-origin: left center;
  border-radius: 999rpx;
}

.knowledge-branch-line {
  height: 8rpx;
  background: linear-gradient(90deg, rgba(92, 152, 255, 0.16), rgba(92, 152, 255, 0.58) 42%, rgba(133, 255, 225, 0.74));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.16);
}

.knowledge-branch-glow {
  height: 18rpx;
  margin-top: -5rpx;
  filter: blur(8rpx);
  background: linear-gradient(90deg, rgba(62, 126, 255, 0.08), rgba(62, 126, 255, 0.24), rgba(104, 255, 221, 0.30));
}

.knowledge-branch-dormant {
  opacity: 0.26;
  filter: saturate(0.62);
}

.knowledge-branch-weak {
  opacity: 0.58;
}

.knowledge-branch-mid {
  opacity: 0.84;
}

.knowledge-branch-strong {
  opacity: 1;
}

.knowledge-branch-line.knowledge-branch-mid,
.knowledge-branch-line.knowledge-branch-strong {
  animation: knowledge-branch-flow 4.2s linear infinite;
}

.knowledge-branch-label {
  width: 176rpx;
  padding: 14rpx 16rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(120, 168, 239, 0.18);
  background: linear-gradient(180deg, rgba(9, 23, 45, 0.94), rgba(8, 17, 34, 0.98));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.05), 0 16rpx 26rpx rgba(2, 10, 24, 0.28);
}

.knowledge-branch-label.knowledge-branch-dormant {
  opacity: 0.42;
}

.knowledge-branch-label.knowledge-branch-strong {
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.08), 0 18rpx 30rpx rgba(2, 10, 24, 0.30), 0 0 32rpx rgba(73, 189, 255, 0.10);
}

.knowledge-branch-name {
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.34;
  color: #f4f8ff;
}

.knowledge-branch-copy {
  margin-top: 8rpx;
  font-size: 20rpx;
  line-height: 1.42;
  color: rgba(193, 213, 240, 0.72);
}

.knowledge-orb {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
}

.knowledge-orb::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border-radius: inherit;
  border: 1rpx solid rgba(164, 225, 255, 0.18);
}

.knowledge-orb-dim {
  background: radial-gradient(circle, rgba(17, 48, 88, 0.88), rgba(9, 23, 44, 0.96));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.04), 0 10rpx 18rpx rgba(1, 8, 20, 0.24);
  opacity: 0.54;
}

.knowledge-orb-lit {
  background: radial-gradient(circle at 32% 28%, rgba(246, 255, 255, 0.96), rgba(155, 240, 255, 0.88) 22%, rgba(60, 171, 255, 0.92) 48%, rgba(16, 63, 156, 0.98));
  box-shadow: inset 0 2rpx 6rpx rgba(255, 255, 255, 0.24), 0 0 28rpx rgba(107, 214, 255, 0.34), 0 16rpx 26rpx rgba(9, 42, 92, 0.38);
  animation: knowledge-orb-float 3.8s ease-in-out infinite;
}

.knowledge-orb-core {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 0 12rpx rgba(255, 255, 255, 0.58);
}

.knowledge-orb-pulse {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  bottom: -10rpx;
  left: -10rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(132, 235, 255, 0.28);
  animation: knowledge-orb-pulse 2.4s ease-out infinite;
}

.knowledge-sparkle {
  border-radius: 999rpx;
}

.knowledge-sparkle-lit {
  background: radial-gradient(circle, rgba(236, 253, 255, 0.96), rgba(131, 229, 255, 0.68) 42%, rgba(131, 229, 255, 0));
  box-shadow: 0 0 16rpx rgba(128, 223, 255, 0.28);
  animation: knowledge-sparkle-flicker 3.2s ease-in-out infinite;
}

.knowledge-sparkle-dim {
  background: radial-gradient(circle, rgba(108, 171, 255, 0.26), rgba(108, 171, 255, 0));
  opacity: 0.32;
}

.knowledge-scene-empty {
  left: 50%;
  top: 50%;
  width: 360rpx;
  transform: translate(-50%, -50%);
  text-align: center;
  color: rgba(196, 214, 238, 0.72);
  line-height: 1.68;
  font-size: 24rpx;
}

.knowledge-scene-stats {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.knowledge-scene-stat-card {
  padding: 18rpx;
  border-radius: 22rpx;
  border: 1rpx solid rgba(117, 168, 240, 0.16);
  background: linear-gradient(180deg, rgba(11, 25, 49, 0.92), rgba(8, 18, 35, 0.96));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
}

.knowledge-scene-stat-label {
  font-size: 22rpx;
