.pdf-viewer-error {
  min-height: 100vh;
  padding: 48rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  background: #f6f7fb;
  color: #1f2937;
}

.pdf-viewer-error-title {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.5;
}

.pdf-viewer-error-copy {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #5b6472;
}
