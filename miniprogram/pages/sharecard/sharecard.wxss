@import "../../app.wxss";

.calendar-weekdays,
.calendar-grid,
.share-calendar-weekdays,
.share-calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 12rpx;
}

.calendar-weekdays,
.share-calendar-weekdays {
  margin-top: 14rpx;
}

.calendar-grid,
.share-calendar-grid {
  margin-top: 14rpx;
}

.calendar-weekday,
.share-calendar-weekday {
  text-align: center;
  font-size: 22rpx;
  color: rgba(166, 187, 216, 0.68);
}

.calendar-cell,
.share-calendar-cell {
  min-height: 60rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(108, 149, 211, 0.16);
  background: linear-gradient(180deg, rgba(15, 28, 49, 0.82), rgba(10, 21, 39, 0.82));
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.share-calendar-cell {
  border-color: rgba(129, 172, 255, 0.18);
  background: rgba(9, 20, 38, 0.72);
}

.calendar-cell-placeholder,
.share-calendar-cell-placeholder {
  border-color: transparent;
  background: transparent;
}

.calendar-cell-today,
.share-calendar-cell-today {
  box-shadow: inset 0 0 0 2rpx #2459d6;
}

.calendar-cell-day,
.share-calendar-day {
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(206, 221, 244, 0.82);
}

.share-calendar-day {
  color: #f0f7ff;
}

.heatmap-band-none {
  background: rgba(15, 28, 49, 0.78);
}

.share-calendar-cell.heatmap-band-none,
.calendar-legend-dot.heatmap-band-none {
  background: rgba(144, 164, 191, 0.22);
}

.heatmap-band-pending {
  background: rgba(116, 148, 201, 0.16);
  border-color: rgba(169, 194, 235, 0.42);
  border-style: dashed;
}

.heatmap-band-low {
  background: #ea6a64;
  border-color: #ea6a64;
}

.heatmap-band-mid {
  background: #f2c84b;
  border-color: #f2c84b;
}

.heatmap-band-high {
  background: #2fbf71;
  border-color: #2fbf71;
}

.share-calendar-cell.heatmap-band-pending .share-calendar-day {
  color: #dfeeff;
}

.share-calendar-cell.heatmap-band-low .share-calendar-day,
.share-calendar-cell.heatmap-band-mid .share-calendar-day,
.share-calendar-cell.heatmap-band-high .share-calendar-day {
  color: #fff;
}

.calendar-legend,
.share-calendar-legend {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  color: #6c7c92;
  font-size: 22rpx;
}

.share-calendar-legend {
  color: rgba(208, 224, 248, 0.82);
}

.calendar-legend-item {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
}

.calendar-legend-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(95, 134, 194, 0.22);
  background: rgba(15, 28, 49, 0.78);
  box-sizing: border-box;
}

.calendar-legend-dot.heatmap-band-none {
  background: rgba(144, 164, 191, 0.22);
  border-color: rgba(144, 164, 191, 0.28);
}

.calendar-legend-dot.heatmap-band-pending {
  background: rgba(116, 148, 201, 0.16);
  border-color: rgba(169, 194, 235, 0.42);
  border-style: dashed;
}

.calendar-legend-dot.heatmap-band-low {
  background: #ea6a64;
  border-color: #ea6a64;
}

.calendar-legend-dot.heatmap-band-mid {
  background: #f2c84b;
  border-color: #f2c84b;
}

.calendar-legend-dot.heatmap-band-high {
  background: #2fbf71;
  border-color: #2fbf71;
}

.share-calendar-section {
  border-color: rgba(88, 166, 255, 0.2);
}

.share-calendar-summary {
  margin-top: 12rpx;
  color: rgba(206, 224, 249, 0.82);
  line-height: 1.62;
}

.share-actions {
  margin-top: 28rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.share-btn {
  margin: 0;
}

.share-btn.primary {
  color: #fff;
  background: linear-gradient(135deg, #2f7aff, #1fd5b9);
}

.share-btn.ghost {
  color: #d8e8ff;
  background: rgba(9, 20, 38, 0.8);
  border: 1rpx solid rgba(129, 172, 255, 0.28);
}

.share-tip,
.share-inline-error {
  margin-top: 18rpx;
  color: rgba(194, 214, 248, 0.76);
  line-height: 1.7;
}

.share-inline-error {
  color: #ffb199;
}

.share-poster-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 1080px;
  height: 2280px;
  opacity: 0;
  pointer-events: none;
}


.share-calendar-section {
  border-color: rgba(88, 166, 255, 0.26);
  background: linear-gradient(180deg, rgba(8, 19, 36, 0.94), rgba(8, 16, 30, 0.88));
}

.share-calendar-topline {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.share-calendar-copy {
  flex: 1;
  min-width: 0;
}

.share-calendar-month-chip {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(125, 171, 255, 0.22);
  background: rgba(10, 24, 48, 0.84);
  color: #dceaff;
  font-size: 22rpx;
  font-weight: 700;
}

.share-calendar-summary {
  margin-top: 12rpx;
  color: rgba(217, 231, 250, 0.82);
  line-height: 1.62;
}

.share-calendar-stats {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.share-calendar-metric {
  padding: 16rpx 18rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(125, 171, 255, 0.16);
  background: linear-gradient(180deg, rgba(13, 28, 50, 0.94), rgba(10, 22, 41, 0.88));
}

.share-calendar-metric-value {
  color: #f6fbff;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.1;
}

.share-calendar-metric-label {
  margin-top: 8rpx;
  color: rgba(176, 198, 229, 0.72);
  font-size: 20rpx;
}

.share-calendar-board {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(125, 171, 255, 0.12);
  background: linear-gradient(180deg, rgba(11, 24, 44, 0.92), rgba(7, 18, 34, 0.88));
}

.share-calendar-weekdays {
  margin-top: 0;
  gap: 10rpx;
}

.share-calendar-grid {
  margin-top: 12rpx;
  gap: 10rpx;
}

.share-calendar-weekday {
  font-size: 20rpx;
  color: rgba(176, 198, 229, 0.66);
  letter-spacing: 2rpx;
}

.share-calendar-cell {
  min-height: 72rpx;
  border-radius: 18rpx;
  border-color: rgba(129, 172, 255, 0.16);
  background: linear-gradient(180deg, rgba(15, 29, 53, 0.94), rgba(9, 20, 39, 0.9));
}

.share-calendar-cell-placeholder {
  background: rgba(10, 19, 34, 0.42);
  border-color: rgba(125, 171, 255, 0.04);
}

.share-calendar-cell-today {
  box-shadow: inset 0 0 0 2rpx rgba(242, 250, 255, 0.72), 0 0 24rpx rgba(86, 171, 255, 0.18);
  transform: translateY(-2rpx);
}

.share-calendar-day {
  color: #f2f8ff;
  font-size: 24rpx;
}

.share-calendar-legend {
  margin-top: 16rpx;
  gap: 12rpx;
}

.share-calendar-legend .calendar-legend-item {
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(125, 171, 255, 0.1);
  background: rgba(9, 20, 38, 0.72);
}

.share-calendar-legend .calendar-legend-dot {
  flex-shrink: 0;
}

